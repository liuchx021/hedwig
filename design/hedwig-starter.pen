{
  "version": "2",
  "themes": {
    "mode": [
      "light",
      "dark"
    ]
  },
  "variables": {
    "color.primary": {
      "type": "color",
      "value": "#c8a44e"
    },
    "color.accent": {
      "type": "color",
      "value": "#4ecdc4"
    },
    "color.error": {
      "type": "color",
      "value": "#e05c5c"
    },
    "color.warning": {
      "type": "color",
      "value": "#e0a84b"
    },
    "color.bg.layout": {
      "type": "color",
      "value": [
        {
          "value": "#ffffff",
          "theme": {
            "mode": "light"
          }
        },
        {
          "value": "#0c1117",
          "theme": {
            "mode": "dark"
          }
        }
      ]
    },
    "color.bg.container": {
      "type": "color",
      "value": [
        {
          "value": "#ffffff",
          "theme": {
            "mode": "light"
          }
        },
        {
          "value": "#141a23",
          "theme": {
            "mode": "dark"
          }
        }
      ]
    },
    "color.bg.elevated": {
      "type": "color",
      "value": [
        {
          "value": "#fafafa",
          "theme": {
            "mode": "light"
          }
        },
        {
          "value": "#1a2230",
          "theme": {
            "mode": "dark"
          }
        }
      ]
    },
    "color.text.primary": {
      "type": "color",
      "value": [
        {
          "value": "#1a1a1a",
          "theme": {
            "mode": "light"
          }
        },
        {
          "value": "#e8e6e1",
          "theme": {
            "mode": "dark"
          }
        }
      ]
    },
    "color.text.secondary": {
      "type": "color",
      "value": [
        {
          "value": "#666666",
          "theme": {
            "mode": "light"
          }
        },
        {
          "value": "#7a8599",
          "theme": {
            "mode": "dark"
          }
        }
      ]
    },
    "radius.default": {
      "type": "number",
      "value": 8
    },
    "radius.small": {
      "type": "number",
      "value": 6
    }
  },
  "children": [
    {
      "id": "login-page",
      "name": "Login Page",
      "type": "frame",
      "x": 0,
      "y": 0,
      "width": 1440,
      "height": 900,
      "fill": "$color.bg.layout",
      "layout": "horizontal",
      "children": [
        {
          "id": "login-brand-panel",
          "name": "Brand Panel",
          "type": "frame",
          "x": 0,
          "y": 0,
          "width": 720,
          "height": "fill_container",
          "fill": "#0c1117",
          "layout": "vertical",
          "justifyContent": "center",
          "alignItems": "center",
          "gap": 12,
          "children": [
            {
              "id": "login-owl",
              "type": "text",
              "x": 0,
              "y": 0,
              "width": "fit_content",
              "height": "fit_content",
              "textGrowth": "auto",
              "content": "🦉",
              "fontSize": 80,
              "textAlign": "center"
            },
            {
              "id": "login-brand-title",
              "type": "text",
              "x": 0,
              "y": 0,
              "width": "fit_content",
              "height": "fit_content",
              "textGrowth": "auto",
              "content": "Hedwig",
              "fontSize": 36,
              "fontWeight": "700",
              "fontFamily": "DM Sans",
              "fill": "$color.primary",
              "textAlign": "center"
            },
            {
              "id": "login-brand-sub",
              "type": "text",
              "x": 0,
              "y": 0,
              "width": "fit_content",
              "height": "fit_content",
              "textGrowth": "auto",
              "content": "CGM · 血糖数据网关",
              "fontSize": 15,
              "fontFamily": "DM Sans",
              "fill": "$color.text.secondary",
              "textAlign": "center"
            }
          ]
        },
        {
          "id": "login-form-panel",
          "name": "Form Panel",
          "type": "frame",
          "x": 0,
          "y": 0,
          "width": 720,
          "height": "fill_container",
          "fill": "$color.bg.layout",
          "layout": "vertical",
          "justifyContent": "center",
          "alignItems": "center",
          "children": [
            {
              "id": "login-card",
              "name": "Login Card",
              "type": "frame",
              "x": 0,
              "y": 0,
              "width": 420,
              "height": "fit_content",
              "fill": "$color.bg.container",
              "cornerRadius": 16,
              "layout": "vertical",
              "padding": 40,
              "gap": 20,
              "children": [
                {
                  "id": "login-title",
                  "type": "text",
