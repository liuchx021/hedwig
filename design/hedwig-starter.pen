                      "fill": "#bfbfbf"
                    },
                    {
                      "id": "username-ph",
                      "type": "text",
                      "x": 0,
                      "y": 0,
                      "width": "fit_content",
                      "height": "fit_content",
                      "textGrowth": "auto",
                      "content": "请输入用户名",
                      "fontSize": 14,
                      "fontFamily": "DM Sans",
                      "fill": "#bfbfbf"
                    }
                  ]
                },
                {
                  "id": "password-input",
                  "name": "Password Input",
                  "type": "frame",
                  "x": 0,
                  "y": 0,
                  "width": "fill_container",
                  "height": 44,
                  "fill": "$color.bg.elevated",
                  "cornerRadius": "$radius.small",
                  "stroke": {
                    "align": "inside",
                    "thickness": 1,
                    "fill": "#d9d9d9"
                  },
                  "layout": "horizontal",
                  "alignItems": "center",
                  "padding": [
                    0,
                    12
                  ],
                  "gap": 8,
                  "children": [
                    {
                      "id": "lock-icon",
                      "type": "icon_font",
                      "x": 0,
                      "y": 0,
                      "width": 16,
                      "height": 16,
                      "iconFontFamily": "lucide",
                      "iconFontName": "lock",
                      "fill": "#bfbfbf"
                    },
                    {
                      "id": "password-ph",
                      "type": "text",
                      "x": 0,
                      "y": 0,
                      "width": "fit_content",
                      "height": "fit_content",
                      "textGrowth": "auto",
                      "content": "请输入密码",
                      "fontSize": 14,
                      "fontFamily": "DM Sans",
                      "fill": "#bfbfbf"
                    }
                  ]
                },
                {
                  "id": "login-btn",
                  "name": "Login Button",
                  "type": "frame",
                  "x": 0,
                  "y": 0,
                  "width": "fill_container",
                  "height": 44,
                  "fill": "$color.primary",
                  "cornerRadius": "$radius.small",
                  "layout": "horizontal",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "children": [
                    {
                      "id": "login-btn-text",
                      "type": "text",
                      "x": 0,
                      "y": 0,
                      "width": "fit_content",
                      "height": "fit_content",
                      "textGrowth": "auto",
                      "content": "登 录",
                      "fontSize": 16,
                      "fontWeight": "500",
                      "fontFamily": "DM Sans",
                      "fill": "#ffffff"
                    }
                  ]
                },
                {
                  "id": "register-link",
                  "type": "text",
                  "x": 0,
                  "y": 0,
                  "width": "fill_container",
                  "height": "fit_content",
                  "textGrowth": "fixed-width",
                  "content": "没有账号？ 立即注册",
                  "fontSize": 14,
                  "fontFamily": "DM Sans",
                  "fill": "$color.text.secondary",
                  "textAlign": "center"
                }
              ]
            }
          ]
        }
      ]
    },
