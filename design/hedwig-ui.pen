                    {
                      "id": "st-btn-add-t",
                      "type": "text",
                      "content": "添加目标",
                      "fontSize": 14,
                      "fill": "#ffffff"
                    }
                  ]
                },
                {
                  "id": "st-btn-sync",
                  "type": "frame",
                  "width": "fit_content",
                  "height": 36,
                  "fill": "$color.bg.container",
                  "cornerRadius": "$radius.small",
                  "stroke": {
                    "align": "inside",
                    "thickness": 1,
                    "fill": "#d9d9d9"
                  },
                  "padding": [
                    0,
                    16
                  ],
                  "layout": "horizontal",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "children": [
                    {
                      "id": "st-btn-sync-t",
                      "type": "text",
                      "content": "同步",
                      "fontSize": 14,
                      "fill": "$color.text.primary"
                    }
                  ]
                }
              ]
            },
            {
              "id": "st-card-row",
              "type": "frame",
              "width": "fill_container",
              "height": "fit_content",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "id": "st-card-1",
                  "type": "frame",
                  "width": "fill_container",
                  "height": "fit_content",
                  "fill": "$color.bg.container",
                  "cornerRadius": "$radius.default",
                  "padding": 16,
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "id": "st-c1t",
                      "type": "text",
                      "content": "NightscoutTargetCard 示例",
                      "fontWeight": "600",
                      "fontSize": 15,
                      "fill": "$color.text.primary"
                    },
                    {
                      "id": "st-c1d",
                      "type": "text",
                      "content": "URL · API Secret · 关联对象 · 启用开关",
                      "fontSize": 12,
                      "fill": "$color.text.secondary"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "not-found-page",
      "name": "404 Page",
      "type": "frame",
      "x": 9600,
      "y": 0,
      "width": 1440,
      "height": 900,
      "fill": "$color.bg.layout",
      "layout": "vertical",
      "justifyContent": "center",
      "alignItems": "center",
      "gap": 16,
      "children": [
        {
          "id": "nf-title",
          "type": "text",
          "content": "404 — 页面不存在",
          "fontSize": 22,
          "fontWeight": "600",
          "fontFamily": "DM Sans",
          "fill": "$color.text.secondary"
        },
        {
          "id": "nf-link",
          "type": "text",
          "content": "返回首页",
          "fontSize": 15,
          "fontFamily": "DM Sans",
          "fill": "$color.accent"
        }
      ]
    }
  ]
}