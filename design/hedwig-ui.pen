                  "y": 0,
                  "width": "fill_container",
                  "height": "fit_content",
                  "textGrowth": "fixed-width",
                  "content": "欢迎回来",
                  "fontSize": 24,
                  "fontWeight": "600",
                  "fontFamily": "DM Sans",
                  "fill": "$color.text.primary",
                  "textAlign": "center"
                },
                {
                  "id": "login-desc",
                  "type": "text",
                  "x": 0,
                  "y": 0,
                  "width": "fill_container",
                  "height": "fit_content",
                  "textGrowth": "fixed-width",
                  "content": "登录 Hedwig 管理系统",
                  "fontSize": 14,
                  "fontFamily": "DM Sans",
                  "fill": "$color.text.secondary",
                  "textAlign": "center"
                },
                {
                  "id": "username-input",
                  "name": "Username Input",
                  "type": "frame",
                  "x": 0,
                  "y": 0,
                  "width": "fill_container",
                  "height": 44,
                  "fill": "$color.bg.elevated",
                  "cornerRadius": "$radius.small",
                  "stroke": {
                    "align": "inside",
                    "thickness": 1,
                    "fill": "#d9d9d9"
                  },
                  "layout": "horizontal",
                  "alignItems": "center",
                  "padding": [
                    0,
                    12
                  ],
                  "gap": 8,
                  "children": [
                    {
                      "id": "user-icon",
                      "type": "icon_font",
                      "x": 0,
                      "y": 0,
